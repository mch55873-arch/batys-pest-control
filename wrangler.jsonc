{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "batys-pest-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "batyspestcontrol.com/*", "zone_name": "batyspestcontrol.com" },
    { "pattern": "www.batyspestcontrol.com/*", "zone_name": "batyspestcontrol.com" },
    { "pattern": "*.batyspestcontrol.com/*", "zone_name": "batyspestcontrol.com" }
  ]
}
